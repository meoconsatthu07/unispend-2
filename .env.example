# ============================================================================
# CẤU HÌNH AI & TESSERACT OCR CHO UNISPEND 2.0
# Sao chép file này thành .env tại thư mục gốc dự án và điền cấu hình của bạn.
# Tuyệt đối không ghi API Key thật vào .env.example hoặc commit .env lên Git.
# ============================================================================

# Nhà cung cấp AI: auto | gemini | openai
AI_PROVIDER=auto

# 1. Google Gemini API (Phân tích văn bản OCR hóa đơn, ảnh hóa đơn, giọng nói & trợ lý)
# Lấy key tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 2. Đường dẫn Tesseract OCR 5.x trên máy (Hỗ trợ nhận diện vie+eng cục bộ)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# 3. OpenAI hoặc API tương thích OpenAI (Tùy chọn dự phòng)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
